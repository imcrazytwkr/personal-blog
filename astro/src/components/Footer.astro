---
import { SITE } from "../constants";

const year = new Date().getFullYear();
---

<footer
  class="mx-auto my-6 flex w-full max-w-3xl flex-none flex-col items-center justify-between gap-6 px-8 text-sm opacity-60 md:flex-row"
>
  <div class="grow">
    &copy; {year}
    <a href={SITE.absoluteUrl}>{SITE.title}</a>
  </div>
  <div class="flex flex-none items-center justify-between gap-6">
    <a
      class="link"
      href="https://astro.build"
      rel="noopener noreferrer"
      target="_blank"
    >
      Powered by Astro
    </a>
    <a
      class="link"
      href="https://github.com/nanxiaobei/hugo-paper"
      rel="noopener noreferrer"
      target="_blank"
    >
      Theme based on Paper
    </a>
  </div>
</footer>
