---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { AUTHOR, BIO } from "../constants";
import type { Page } from "astro";

// Must match the PAGE_SIZE in src/pages/page/[page].astro.
const PAGE_SIZE = 10;

// Newest first — matches Middleman's default blog article order.
const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const firstPage = posts.slice(0, PAGE_SIZE);

// Page 1 has no prev; next points at /page/2 when there are more pages.
const page: Page<CollectionEntry<"blog">> = {
  data: firstPage,
  url: { current: Astro.url.pathname } as Page["url"],
  start: 0,
  end: PAGE_SIZE - 1,
  total: posts.length,
  currentPage: 1,
  size: PAGE_SIZE,
  lastPage: -1,
};

if (posts.length > PAGE_SIZE) {
  page.url.next = "/page/2";
}

// Manual srcset over the 6 pre-baked avatar webp (astro:assets regen is post-MVP).
const avatarImages = import.meta.glob(
  "../assets/images/persica_coffee_avatar_x*.webp",
  {
    eager: true,
    query: "?url",
    import: "default",
  },
) as Record<string, string>;

const avatarSrcs = Object.entries(avatarImages)
  .map(([path, url]) => {
    const m = path.match(/_x(\d+)\.webp$/);
    return { scale: m ? parseInt(m[1], 10) : 0, url };
  })
  .sort((a, b) => a.scale - b.scale);

const avatarSrc = avatarSrcs[0]?.url ?? "";
const avatarSrcSet = avatarSrcs.map((s) => `${s.url} ${s.scale}x`).join(", ");
---

<Layout>
  <div class="-mt-2 mb-16 flex items-center">
    <div
      class="not-prose mr-5 shrink-0 rounded-full border-[0.5px] border-black/10 bg-white/50 p-3 dark:bg-white/20"
    >
      <img
        src={avatarSrc}
        srcset={avatarSrcSet}
        alt={AUTHOR.name}
        class="my-0 aspect-square w-16 rounded-full bg-black/5 dark:bg-black/80"
      />
    </div>
    <div>
      <h1 class="mb-2 mt-3 text-[1.6rem] font-bold">{AUTHOR.name}</h1>
      <p class="not-prose wrap-break-word">{BIO}</p>
    </div>
  </div>
  <PostList page={page} />
</Layout>
