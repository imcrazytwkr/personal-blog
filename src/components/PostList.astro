---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

// Takes a full Astro Page<T>. Paginated routes (page/[page].astro) pass the
// real `page` from paginate(); non-paginated listings (index.astro, tag pages)
// pass a synthetic single-page Page object.
type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
---

{
  page.data.map((post) => (
    <section class="relative my-10 first-of-type:mt-0 last-of-type:mb-0">
      {post.data.featured && (
        <span class="mb-2 ml-px inline-block text-sm font-medium tracking-wider text-red-700 uppercase">
          Featured
        </span>
      )}
      <h2 class="my-0! pb-1 leading-none font-bold">{post.data.title}</h2>
      <time class="text-sm antialiased opacity-60">{fmt(post.data.date)}</time>
      <a href={`/post/${post.id}/`} class="absolute inset-0 opacity-0">
        {post.data.title}
      </a>
    </section>
  ))
}

{
  (page.url.prev || page.url.next) && (
    <nav class="mt-14 flex items-center justify-between">
      {page.url.prev && (
        <a href={page.url.prev} class="btn not-prose">
          ← Previous page
        </a>
      )}
      {page.url.next && (
        <a href={page.url.next} class="btn not-prose">
          Next page →
        </a>
      )}
    </nav>
  )
}
