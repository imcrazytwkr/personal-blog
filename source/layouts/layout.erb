<!doctype html>
<html
  class="not-ready bg-wheat dark:bg-black lg:text-base"
  lang="<%= data.meta.dig(:site, :language_code) || "en" %>"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color">
    <%# Use the title from a page's frontmatter if it has one %>
    <title><%= page_title %></title>
    <link rel="alternate" type="application/atom+xml" title="<%= site_title %> feed" href="<%= absolute_url("/feed.xml") %>" />
    <%= vite_client_tag %>
    <%= vite_inline_typescript "theme-base" %>
    <%= vite_stylesheet_tag "app" %>
  </head>
  <body class="flex flex-col items-stretch text-black dark:text-white duration-200 ease-out">
    <%= partial "partials/header" %>
    <main class="grow prose prose-neutral dark:prose-invert mx-auto w-full max-w-3xl px-8 pb-16 pt-12">
      <%= yield %>
    </main>
    <%= partial "partials/footer" %>
  </body>
</html>
